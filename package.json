{
  "name": "krmap",
  "version": "1.0.0",
  "description": "대한민국 행정구역(시도·시군구·읍면동) 지도를 SVG·PNG·PPTX로 만드는 도구 — 웹 도구, 명령줄(krmap), MCP 서버",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/worlyung/krmap.git"
  },
  "keywords": [
    "korea",
    "map",
    "svg",
    "pptx",
    "choropleth",
    "행정구역",
    "지도",
    "mcp"
  ],
  "private": true,
  "bin": {
    "krmap": "tools/krmap.mjs"
  },
  "scripts": {
    "krmap": "node tools/krmap.mjs",
    "mcp": "node tools/mcp-server.mjs",
    "test": "node tools/test.mjs && node tools/test-advanced.mjs && node tools/test-snap.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-js": "2.6.2",
    "pptxgenjs": "4.0.1",
    "pretendard": "1.3.9",
    "read-excel-file": "9.3.12",
    "zod": "3.25.76"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "devDependencies": {
    "pngjs": "7.0.0"
  }
}
